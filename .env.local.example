# انسخ هذا الملف وسمّه .env.local ثم عبّي القيم من لوحة تحكم Supabase و Moyasar
# Supabase: Project Settings → API
# Moyasar:  Dashboard → Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح صلاحيات كاملة — سري جدًا، لا تشاركه ولا ترفعه لأي مكان عام
# Supabase: Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# مفاتيح Moyasar — من https://dashboard.moyasar.com
# publishable key آمن يظهر بالمتصفح، لكن secret key سري تمامًا (سيرفر فقط)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_MOYASAR_PUBLISHABLE_KEY
MOYASAR_SECRET_KEY=REPLACE_WITH_YOUR_MOYASAR_SECRET_KEY

# رابط موقعك (بدون / بالنهاية) — يُستخدم لبناء رابط الرجوع بعد الدفع
NEXT_PUBLIC_SITE_URL=http://localhost:3000
